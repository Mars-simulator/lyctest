# ===== 应用 =====
# 宿主机端口映射
APP_PORT=3000
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=nest-typeorm-crud
APP_VERSION=0.0.1

# ===== JWT =====
# 生产必须替换为高强度随机串，否则应用拒绝启动
JWT_SECRET=please-change-me-in-production

# ===== 数据库（容器内使用服务名 mysql） =====
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=faben123
DB_DATABASE=nest_crud_demo
# 首次启动自动建表（仅演示用；生产应改用 migration 并设为 false）
DB_SYNC=true

# ===== Redis（容器内使用服务名 redis） =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== CORS（逗号分隔；留空表示反射请求 Origin，生产建议显式配置） =====
CORS_ORIGINS=

# ===== 宿主机端口映射 =====
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
